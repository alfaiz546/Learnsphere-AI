# LearnSphere AI - Staging Deployment Configuration Template
# Database (Supabase PostgreSQL with SSL required)
DATABASE_URL=postgresql://postgres:[STAGING_DB_PASSWORD]@[STAGING_HOST]:5432/postgres?sslmode=require
REDIS_URL=redis://[STAGING_REDIS_HOST]:6379/0

# Production/Staging SECRET_KEY MUST be at least 64 random hex characters
SECRET_KEY=[GENERATE_SECURE_RANDOM_64_CHAR_HEX_KEY]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI Service Configuration
GEMINI_API_KEY=[STAGING_GEMINI_API_KEY]
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30

# CORS & Staging Domain Configuration
CORS_ORIGINS=["https://staging.learnsphere.ai","http://localhost:5173"]
ENVIRONMENT=staging
APP_NAME=LearnSphere AI (Staging)

# Strict Token Blacklisting Policy
# In staging and production, Redis fail-closed (503 Service Unavailable) is strictly enforced
AUTH_REQUIRE_REDIS_BLACKLIST=True
