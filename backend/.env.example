# Database (Supabase PostgreSQL)
# Direct connection: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or Transaction Pooler (port 6543): postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=learnsphere-super-secret-jwt-key-32-chars-long-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
ENVIRONMENT=development
APP_NAME=LearnSphere AI

# Security: Enforces fail-closed 503 on Redis outage if True. Automatically True in staging/production.
AUTH_REQUIRE_REDIS_BLACKLIST=False

